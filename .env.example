# Local development settings. Copy to .env.local and adjust.
# In production these values live in /etc/craftingai/craftingai.env (written by install.sh).

# Public address of the site. Used for the same-origin check and cookie security.
APP_URL=http://localhost:3000

# API key for the AI models. For development without a key, start the mock
# provider (npm run mock:upstream) and use the two lines below instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY=mock
# ANTHROPIC_BASE_URL=http://127.0.0.1:4010

# Where the SQLite database is stored (default: ./.data).
# DATA_DIR=./.data

# Secret used to pseudonymise IP addresses. Required in production (32+ characters).
# APP_SECRET=

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=1

# Initial branding and limits (can be changed later in the admin dashboard).
# SITE_NAME=CraftingAI
# CONTACT_EMAIL=you@example.com
# DAILY_BUDGET_USD=10
